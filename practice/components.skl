from math use clamp

class Health {
    current_health: i = 100
    max_health: i = 100
    regen_rate: f = 0.5      # health per second
    regen_delay: f = 3.0     # seconds
    is_dead: bool = false
    on_death: fn() = lambda() -> void { print("dead") }

    fn health_lost() -> i { return self.max_health - self.current_health }

    fn die() -> void {
        if self.is_dead { return }
        self.is_dead = true
        self.on_death()
        # died.emit(self)
    }

    fn take_damage(amount: i) -> void {
        if self.is_dead { return }
        self.current_health = clamp(self.current_health - amount, 0, self.max_health)
        # health_changed.emit(self.current_health)
        if self.current_health == 0 { self.die() }
    }

    fn heal(amount: i) -> i {
        if self.is_dead { return 0 }
        var before: i = self.current_health
        self.current_health = clamp(self.current_health + amount, 0, self.max_health)
        # health_changed.emit(self.current_health)
        return self.current_health - before
    }
}
