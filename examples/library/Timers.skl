# Timers: cooldowns and repeating timers for games.
# Use it with:  from Timers use Cooldown, Timer, timer_done

# Fired by every Timer when it finishes, with the timer's name.
signal timer_done(name)

# Add to any class that can only act every so often:
#   class Gun:(Cooldown) { cooldown: f = 0.5 }
comp Cooldown {
    cooldown: f = 1.0
    remaining: f = 0.0

    fn ready() -> bool { return self.remaining <= 0.0 }

    # Try to act. Returns true (and starts the cooldown) if ready.
    fn trigger() -> bool {
        if not self.ready() { return false }
        self.remaining = self.cooldown
        return true
    }

    fn tick_cooldown(dt: f) {
        if self.remaining > 0.0 { self.remaining -= dt }
    }
}

# A named timer that fires `timer_done` when it runs out.
class Timer {
    name: s = "timer"
    duration: f = 1.0
    elapsed: f = 0.0
    running: bool = false
    repeat: bool = false

    fn init(name: s, duration: f, repeat: bool) {
        self.name = name
        self.duration = duration
        self.repeat = repeat
    }

    fn start() {
        self.elapsed = 0.0
        self.running = true
    }

    fn stop() { self.running = false }

    fn tick(dt: f) {
        if not self.running { return }
        self.elapsed += dt
        if self.elapsed >= self.duration {
            timer_done(self.name)
            if self.repeat { self.elapsed -= self.duration } else { self.running = false }
        }
    }
}

