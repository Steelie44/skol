# Mathx: small math helpers for games.
# Use it with:  from Mathx use sign, approach, remap, round_to, chance

from math use pow, round, random

# -1.0, 0.0 or 1.0 depending on the sign of x.
fn sign(x: f) -> f {
    if x > 0.0 { return 1.0 }
    if x < 0.0 { return -1.0 }
    return 0.0
}

# Move `current` toward `target` by at most `step` (never overshoots).
fn approach(current: f, target: f, step: f) -> f {
    if current < target {
        if current + step > target { return target }
        return current + step
    }
    if current - step < target { return target }
    return current - step
}

# Map x from the range [in_lo, in_hi] to [out_lo, out_hi].
fn remap(x: f, in_lo: f, in_hi: f, out_lo: f, out_hi: f) -> f {
    return out_lo + (x - in_lo) * (out_hi - out_lo) / (in_hi - in_lo)
}

# Round to a number of decimal places: round_to(3.14159, 2) is 3.14.
fn round_to(x: f, places: i) -> f {
    var m: f = pow(10.0, float(places))
    return float(round(x * m)) / m
}

# true with the given probability, e.g. chance(25.0) is true 25% of the time.
fn chance(percent: f) -> bool {
    return random() * 100.0 < percent
}
